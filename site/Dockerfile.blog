FROM ghcr.io/gohugoio/hugo:v0.167.0 AS builder
WORKDIR /src
COPY --chown=0:0 . .
USER root
RUN hugo --minify --gc \
    && test -f public/hugo-content/lib/mermaid.js \
    && test -f public/hugo-content/lib/mathjax/tex-svg.js \
    && test -f public/hugo-content/lib/zoom.js

FROM node:26-alpine AS pagefind
WORKDIR /src
COPY --from=builder /src/public ./public
RUN npx -y pagefind@1.5.2 --site public --output-subdir _pagefind --force-language all

FROM nginx:1.27-alpine
COPY --from=pagefind /src/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
