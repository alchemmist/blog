FROM ghcr.io/gohugoio/hugo:v0.151.2 AS builder
WORKDIR /src
COPY . .
RUN hugo --minify --gc

FROM node:22-alpine AS pagefind
WORKDIR /src
COPY --from=builder /src/public ./public
RUN npx -y pagefind@1.5.2 --site public --output-subdir _pagefind --force-language all

FROM nginx:1.27-alpine
COPY --from=pagefind /src/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
