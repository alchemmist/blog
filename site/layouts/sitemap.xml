{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Pages }}
    {{/* Книги рендерятся как render:link (без HTML-файла) — в sitemap им не место */}}
    {{ if and (eq .Kind "page") (eq .Section "books") }}{{ continue }}{{ end }}
    {{/* Индексы таксономий отключены (disableKinds) — их HTML не существует */}}
    {{ if eq .Kind "taxonomy" }}{{ continue }}{{ end }}
    {{/* Термы author/status ниоткуда не слинкованы — поисковики считают их
         малоценными сиротами; в sitemap оставляем только term-страницы,
         на которые реально ведут ссылки (tags/topics/genre) */}}
    {{ if and (eq .Kind "term") (in (slice "author" "status") .Data.Plural) }}{{ continue }}{{ end }}
    {{/* Единственная каноничная главная — корень; /ru/ редиректится Caddy на /,
         редиректу в sitemap не место */}}
    {{ if and (eq .Kind "home") (ne .Permalink ("/" | absURL)) }}{{ continue }}{{ end }}
    <url>
      <loc>{{ .Permalink }}</loc>
      {{ if not .Lastmod.IsZero }}
        <lastmod>{{ .Lastmod.UTC.Format "2006-01-02T15:04:05Z" | safeHTML }}</lastmod>
      {{ end }}
      {{ with .Sitemap.ChangeFreq }}
        <changefreq>{{ . }}</changefreq>
      {{ end }}
    </url>
  {{ end }}
</urlset>
